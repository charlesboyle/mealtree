# Optional local overrides — copy to .env.local.
# Supabase settings are already in .env (committed). To run on bundled
# placeholder data instead, set both of these to empty values:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
